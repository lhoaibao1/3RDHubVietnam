{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@admin/*": ["admin/src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "admin/src/**/*.ts", "admin/src/**/*.vue", "build/**/*.ts", "vite.config.ts", "vite.admin.config.ts"]
}
